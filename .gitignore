# ----------------------------
# ModelSim/QuestaSim
transcript*
vsim.wlf
modelsim.ini
*.dbg
*.mif
work/
*.db/

# Icarus Verilog
*.vpp
*.log

# Vivado
*.jou
*.log
*.str
.xpr/
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.srcs/
*.gen/

