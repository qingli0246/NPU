# ============================================================
# NPU 项目 Git 忽略文件配置
# ============================================================

# ========================================
# 编译输出和可执行文件
# ========================================
*.exe
*_sim
npu_sim.exe
*.o
*.vvp
output/

# ========================================
# 仿真波形和临时文件
# ========================================
*.vcd
*.fsdb
*.wlf
*.trn
*.fst
*.ghw

# ModelSim/QuestaSim
transcript*
vsim.wlf
modelsim.ini
*.dbg
*.mif
work/
*.db/

# Vivado
*.jou
*.str
.xpr/
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.srcs/
*.gen/

# ========================================
# 日志和文本文件
# ========================================
# 忽略仿真日志，但保留文档
*.log
TB/*_output/*.log          # 忽略测试输出日志
!README.md
!docs/*.md
!TB/README.md              # 保留测试目录的README
!TB/*_output/README.md     # 保留测试报告

# ========================================
# 脚本和工具
# ========================================
# 保留运行脚本，仅忽略临时清理脚本
cleanup_old_files.ps1
run_sim.ps1
run_*.ps1

# ========================================
# 临时状态文件和其他
# ========================================
tatus
.gitattributes
*.tmp
*.bak
*.backup
*.old
*.orig
